# ============================================================
# SOJU FnB Backend — Environment Variables Example
# Copy to .env and fill with real values (NEVER commit .env)
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Database (MySQL 8 via Prisma)
DATABASE_URL="mysql://root:CHANGE_ME_DB_PASSWORD@localhost:3306/buku_dapur"

# Auth / JWT
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_JWT_SECRET"

# CORS & Frontend URL (comma-separated allowed origins)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
WEB_APP_URL="http://localhost:3000"

# Gemini AI (Hybrid RAG — backend only)
GEMINI_API_KEY="CHANGE_ME_GEMINI_API_KEY"

# Email Service
# Option 1 (Recommended for UAS/Demo): Gmail SMTP via Nodemailer App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Option 2: Resend API (leave both SMTP and RESEND_API_KEY empty for local console fallback)
RESEND_API_KEY=""
EMAIL_FROM="SOJU FnB <no-reply@example.com>"

# S3-Compatible Object Storage (MinIO / Cloudflare R2 / Supabase Storage)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="soju-media"
S3_ACCESS_KEY_ID="CHANGE_ME_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="CHANGE_ME_S3_SECRET_KEY"
S3_PUBLIC_BASE_URL="http://localhost:9000/soju-media"
S3_FORCE_PATH_STYLE="true"
